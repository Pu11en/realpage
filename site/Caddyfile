# One address for the site and the chat. The chat app (Open WebUI)
# sits behind this door on Railway's private network, so the framed chat and the
# page are the same site and its sign-in cookie works everywhere (incl. Safari).
#
# Since 2026-09-18 (investor launch) the whole site is open: every page and its data
# load without sign-in. Only the chat itself asks for a free account, inside its panel.
{
	admin off
	auto_https off
}

(security_headers) {
	# Standard browser security headers on every response. COOP allows popups so
	# sign-in providers still work. The CSP keeps scripts, frames and plugins to
	# this site; the chat app (Open WebUI) still needs inline scripts and eval,
	# so those stay allowed. Images may also come from Google (sign-in avatars).
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.googleusercontent.com; font-src 'self' data:; connect-src 'self' https://cranesignal.com; media-src 'self' blob: data:; worker-src 'self' blob:; frame-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://accounts.google.com"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin-allow-popups
		Cross-Origin-Resource-Policy same-site
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

:{$PORT:8080} {
	encode gzip

	import security_headers

	# Always public: the privacy page, and the shell it needs to look right
	# (styles, fonts, favicon). None of these carry data.
	# robots.txt, sitemap.xml and llms.txt must answer before any sign-in logic: a crawler
	# that gets a redirect here learns nothing about the site. indexnow-<key>.txt is the
	# proof-of-ownership file the IndexNow engines fetch; it is public on purpose.
	@public_site path /privacy.html /robots.txt /sitemap.xml /llms.txt /llms-full.txt /indexnow-*.txt /css/* /fonts/* /favicon.ico /favicon.png /favicon.svg /apple-touch-icon.png
	handle @public_site {
		root * {$SITE_ROOT:/srv}
		file_server
	}

	# "/" is the site's home page (the lead list), except inside the chat panel's frame, where
	# it is the chat app's home.
	@home {
		path /
		not header Sec-Fetch-Dest iframe
	}
	handle @home {
		# The app opens on the lead list. Served directly rather than redirected: a 302 on
		# the home page costs a round trip and dilutes the URL that search engines rank.
		root * {$SITE_ROOT:/srv}
		rewrite * /index.html
		file_server
	}

	# The app's pages and their data: open to everyone, no sign-in.
	@app path /index.html /landing.html /master-table.html /property.html /under-the-hood.html /sample-lead-pack.pdf /leads/* /js/* /data/* /vendor/* /img/*
	handle @app {
		root * {$SITE_ROOT:/srv}
		file_server
	}

	# The chat app: /auth, /oauth, /api, /ws, /_app, /static, /c/..., and "/" when
	# it's the chat panel's own iframe (the @home block above only claims "/"
	# outside the iframe).
	@chat path / /auth* /oauth* /api/* /ws* /_app/* /static/* /c/*
	handle @chat {
		reverse_proxy {$CHAT_UPSTREAM:http://propertystack-chat.railway.internal:8080}
	}

	# Anything else is a real CraneSignal 404, not the chat app's leads page.
	handle {
		error * 404
	}
	handle_errors {
		# Errors drop earlier headers, so set them again here.
		import security_headers
		@notfound expression {http.error.status_code} == 404
		handle @notfound {
			root * {$SITE_ROOT:/srv}
			rewrite * /404.html
			file_server
		}
	}
}
