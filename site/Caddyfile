# One address for the site and the chat (PLAN-v6 C2). The chat app (Open WebUI)
# sits behind this door on Railway's private network, so the framed chat and the
# page are the same site and its sign-in cookie works everywhere (incl. Safari).
#
# Since 2026-09-15 (audit E1) the whole app needs sign-in: every app page and its
# data files ask the chat app "is this visitor signed in?" before they are served.
# Only the privacy page, the styles/fonts/favicons the public page needs, and the
# chat app's own sign-in screen stay open.
{
	admin off
	auto_https off
}

:{$PORT:8080} {
	encode gzip

	# Always public: the privacy page, and the shell it needs to look right
	# (styles, fonts, favicon). None of these carry data.
	@public_site path /privacy.html /css/* /fonts/* /favicon.ico /favicon.png /favicon.svg /apple-touch-icon.png
	handle @public_site {
		root * {$SITE_ROOT:/srv}
		file_server
	}

	# "/" is the site's home page, except inside the chat panel's frame, where it
	# is the chat app's home. The site home needs sign-in, like the other pages.
	@home {
		path /
		not header Sec-Fetch-Dest iframe
	}
	handle @home {
		forward_auth {$CHAT_UPSTREAM:http://propertystack-chat.railway.internal:8080} {
			uri /api/v1/auths/
			@unauthorized status 401 403
			handle_response @unauthorized {
				redir * /auth?redirect={http.request.uri} 302
			}
		}
		root * {$SITE_ROOT:/srv}
		rewrite * /index.html
		file_server
	}

	# The app's pages and their data. Not signed in -> the chat's sign-in page,
	# which brings them back to the page they asked for.
	@app path /index.html /map.html /master-table.html /property.html /ai-visibility.html /under-the-hood.html /js/* /data/* /vendor/*
	handle @app {
		forward_auth {$CHAT_UPSTREAM:http://propertystack-chat.railway.internal:8080} {
			uri /api/v1/auths/
			@unauthorized status 401 403
			handle_response @unauthorized {
				redir * /auth?redirect={http.request.uri} 302
			}
		}
		root * {$SITE_ROOT:/srv}
		file_server
	}

	# The chat app: /auth, /oauth, /api, /ws, /_app, /static, /c/..., and "/" when
	# it's the chat panel's own iframe (the @home block above only claims "/"
	# outside the iframe).
	@chat path / /auth* /oauth* /api/* /ws* /_app/* /static/* /c/*
	handle @chat {
		reverse_proxy {$CHAT_UPSTREAM:http://propertystack-chat.railway.internal:8080}
	}

	# Anything else is a real CraneSignal 404, not the chat app's leads page.
	handle {
		error * 404
	}
	handle_errors {
		@notfound expression {http.error.status_code} == 404
		handle @notfound {
			root * {$SITE_ROOT:/srv}
			rewrite * /404.html
			file_server
		}
	}
}
